{
  "name": "web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "gen": "openapi-typescript ../concept-design/api/openapi.yaml -o src/api/generated/schema.d.ts",
    "build": "openapi-typescript ../concept-design/api/openapi.yaml -o src/api/generated/schema.d.ts && vite build",
    "typecheck": "openapi-typescript ../concept-design/api/openapi.yaml -o src/api/generated/schema.d.ts && vue-tsc --noEmit",
    "test": "openapi-typescript ../concept-design/api/openapi.yaml -o src/api/generated/schema.d.ts && vitest run"
  },
  "dependencies": {
    "idb": "^8.0.4",
    "pinia": "^4.1.0",
    "vue": "^3.5.0",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.0",
    "@vue/test-utils": "^2.6.0",
    "fake-indexeddb": "^6.2.8",
    "happy-dom": "^21.0.4",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vitest": "~4.1.12",
    "vue-tsc": "^3.0.0"
  }
}
