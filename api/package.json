  },
  "devDependencies": {
    "wrangler": "4.124.0",
    "@cloudflare/workers-types": "latest",
    "@cloudflare/vitest-pool-workers": "0.23.0",
    "vitest": "~4.1.0",
    "typescript": "~5.9.3",
    "openapi-typescript": "^7.0.0"
  }
}
