{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasvi-api-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "vars": { "ENABLE_DEV_EMIT": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "nasvi-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }],
  "env": {
    "production": {
      "name": "nasvi-api-production",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENABLE_DEV_EMIT": "false",
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_PRODUCTION_ACCESS_TEAM_DOMAIN",
        "ACCESS_AUD": "REPLACE_WITH_PRODUCTION_ACCESS_AUD"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "nasvi-production", "database_id": "REPLACE_WITH_PRODUCTION_D1_DATABASE_ID", "migrations_dir": "migrations" }],
      "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
    },
    "preview": {
      "name": "nasvi-api-preview",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "ENABLE_DEV_EMIT": "false",
        "ACCESS_TEAM_DOMAIN": "REPLACE_WITH_PREVIEW_ACCESS_TEAM_DOMAIN",
        "ACCESS_AUD": "REPLACE_WITH_PREVIEW_ACCESS_AUD"
      },
      "d1_databases": [{ "binding": "DB", "database_name": "nasvi-preview", "database_id": "REPLACE_WITH_PREVIEW_D1_DATABASE_ID", "migrations_dir": "migrations" }],
      "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
      "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
    }
  }
}
