{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nasvi-api-prototype",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-15",
  "vars": { "ENABLE_DEV_EMIT": "true" },
  "d1_databases": [{ "binding": "DB", "database_name": "nasvi-local", "database_id": "00000000-0000-0000-0000-000000000000", "migrations_dir": "migrations" }],
  "durable_objects": { "bindings": [{ "name": "HUB", "class_name": "Hub" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["Hub"] }]
}
